# ================================================================
# Email Platform — Docker Compose env (EXAMPLE / tracked template)
# ================================================================
# Copy to .env.docker:
#   cp .env.docker.example .env.docker
# Then set the 6 `replace-me-*` secrets with real values.
# See docs/runbooks/env-setup.md for onboarding and rotation procedures.
#
# `.env.docker` is UNTRACKED (.gitignore line 17) — never `git add` it.
# This template is the canonical source of key-set for the docker-isolated env.
# ================================================================

# --- HTTP Ports ---
GATEWAY_PORT=3000
AUTH_PORT=3001
SENDER_PORT=3002
PARSER_PORT=3003
AUDIENCE_PORT=3004
NOTIFIER_PORT=3005

# --- gRPC Server Ports (NEW — Phase 999.1.9 D-15 — HTTP↔gRPC symmetry) ---
AUTH_GRPC_PORT=50051
SENDER_GRPC_PORT=50052
PARSER_GRPC_PORT=50053
AUDIENCE_GRPC_PORT=50054
NOTIFIER_GRPC_PORT=50055

# --- gRPC URLs (Docker Compose service names as hostnames) ---
AUTH_GRPC_URL=auth:50051
SENDER_GRPC_URL=sender:50052
PARSER_GRPC_URL=parser:50053
AUDIENCE_GRPC_URL=audience:50054
NOTIFIER_GRPC_URL=notifier:50055

# --- Infrastructure (Docker Compose service names as hostnames) ---
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/email_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=email_platform
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://rabbitmq:5672
STORAGE_ENDPOINT=garage
STORAGE_PORT=3900
STORAGE_PROTOCOL=http
STORAGE_ACCESS_KEY=replace-me-storage-access-key
STORAGE_SECRET_KEY=replace-me-storage-secret-key
STORAGE_REGION=garage
STORAGE_PUBLIC_URL=http://public.localhost:3902
STORAGE_MAX_UPLOAD_BYTES=104857600

# Garage admin token (consumed by garage + garage-webui sidecar in docker-compose.infra.yml)
GARAGE_ADMIN_TOKEN=local-dev-admin-token-static-value-for-local-only

# Garage RPC secret — 32-byte hex (openssl rand -hex 32). REQUIRED for Garage v2 cluster auth.
# See `docs/runbooks/env-setup.md` § Secret Rotation Procedure. Rotated by DevOps per Phase 999.17.2 D-11.
GARAGE_RPC_SECRET=replace-me-rotated-by-devops

# --- Cross-Cutting ---
LOG_LEVEL=info
LOG_FORMAT=json
CORS_ORIGINS=*
CORS_STRICT=false

# --- Docker-only: proto path inside container ---
PROTO_DIR=/app/proto

# --- External APIs (Phase 24) ---
# All variables REQUIRED — no Zod defaults or optionals. Services fail boot if missing.
# See `docs/runbooks/env-setup.md` § Secret Rotation Procedure for where to obtain each secret.
TELEGRAM_BOT_TOKEN=replace-me-telegram-bot-token
TELEGRAM_BASE_URL=https://api.telegram.org
APPSTORESPY_API_KEY=replace-me-appstorespy-api-key
APPSTORESPY_BASE_URL=https://api.appstorespy.com
CLOUDFN_API_KEY=replace-me-cloudfn-api-key
CLOUDFN_BASE_URL=https://us-central1-example.cloudfunctions.net

# --- Production Hardening ---
GRPC_DEADLINE_MS=5000
RATE_LIMIT_BURST_TTL=1000
RATE_LIMIT_BURST_LIMIT=10
RATE_LIMIT_SUSTAINED_TTL=60000
RATE_LIMIT_SUSTAINED_LIMIT=100
